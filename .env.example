# 复制为 .env 并填写真实值；不要提交包含凭证的 .env。
# DashScope API Key - 从 https://dashscope.console.aliyun.com/ 获取
DASHSCOPE_API_KEY=''

# 后端及 Makefile 管理的前端端口
# SERVER_PORT=9900
# WEB_PORT=8080
# WEB_BIND_ADDRESS='0.0.0.0'

# 快速聊天、流式聊天和 AI Ops 共用的模型（须支持工具调用）
# DASHSCOPE_CHAT_MODEL='qwen-plus'
# 普通模型请求总超时、流式模型请求读空闲超时（毫秒）
# DASHSCOPE_HTTP_TIMEOUT_MS=180000
# 知识库检索最多返回的文档分片数
# RAG_TOP_K=3

# 本 Agent 专用的阿里云 SLS 只读 RAM 用户凭证
ALIBABA_CLOUD_ACCESS_KEY_ID=''
ALIBABA_CLOUD_ACCESS_KEY_SECRET=''

# 多云连接开关与默认日志源（默认启用阿里云；不需要选择厂商 Profile）
# LOGS_MOCK_ENABLED=false
# LOGS_DEFAULT_SOURCE=gb-orchestration
# ALIYUN_SLS_MCP_ENABLED=true
# ALIYUN_SLS_MCP_URL='http://127.0.0.1:8181'
# ALIYUN_SLS_MCP_SSE_ENDPOINT='/sse'
# TENCENT_CLS_MCP_ENABLED=false
# TENCENT_CLS_MCP_URL='https://mcp-api.tencent-cloud.com'
# TENCENT_CLS_MCP_SSE_ENDPOINT='/sse/你的实际服务路径'
# HUAWEI_LTS_MCP_ENABLED=false
# HUAWEI_LTS_MCP_URL=''
# HUAWEI_LTS_MCP_SSE_ENDPOINT='/sse'

# Prometheus 告警查询地址（默认不使用模拟数据；真实告警查询需要该服务可访问）
# PROMETHEUS_BASE_URL='http://127.0.0.1:9090'
# PROMETHEUS_TIMEOUT=10
# PROMETHEUS_MOCK_ENABLED=false

# Milvus 配置（如果需要）
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
